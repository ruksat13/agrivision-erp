rules_version = '2';

// AgriVision ERP — Firestore Security Rules
// Implements the access matrix in docs/PROJECT-OUTLINE.md §4, as outlined in
// docs/FIRESTORE-SCHEMA.md §7. These enforce on the server; the route guard in
// ProtectedRoute.js only shapes the UI.
//
// Every rule below reads the caller's profile from users/{uid}, whose document
// ID is the Firebase Auth UID — scripts/seed-auth.mjs explains why that has to
// be true. An account that authenticates but has no profile is denied
// everything, which is exactly the session AuthContext.js refuses to leave open.
//
// ──────────────────────────────────────────────────────────────────────────
// These are the real rules and they are meant to be deployed:
//
//   firebase deploy --only firestore:rules
//
// The blanket development rule that used to sit here — everything open until
// 2026-09-15 — has been removed. It expired before the showcase either way, so
// it was never going to survive the demonstration, and a rule that grants
// everything is not something to keep next to the rules that do not.
//
// The emulator still needs a permissive copy to seed against. It has its own,
// in scripts/emulator-rules.mjs, which never touches this file:
//
//   node scripts/emulator-rules.mjs dev     # permissive — to seed
//   node scripts/emulator-rules.mjs real    # this file
// ──────────────────────────────────────────────────────────────────────────
//
// ── How these rules constrain the QUERIES the app may send ────────────────
//
// A rule that names `resource.data` cannot be satisfied by a whole-collection
// query. Rules are not filters: Firestore refuses the LIST outright rather than
// narrowing it, so a screen asking for every dealer gets permission-denied
// instead of a short list. Any collection scoped with myArea() or mine() below
// therefore requires the service layer to send the matching where() clause —
// listCustomers() in src/services/customers.js is the worked example, and the
// customers indexes in firestore.indexes.json exist for exactly those queries.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return profile().role;
    }

    function active() {
      return signedIn() && profile().status == 'Active';
    }

    // Full visibility across every office
    function isAdmin() {
      return active() && role() in ['Super Admin', 'Managing Director'];
    }

    function isSuperAdmin() {
      return active() && role() == 'Super Admin';
    }

    // An Area Manager sees only their own area
    function myArea(areaId) {
      return active() && role() == 'Area Manager' && profile().areaId == areaId;
    }

    // A Sales Officer sees only records they own. The officerId stored on
    // customers, sales and sale_items is the officer's own uid.
    function mine(officerId) {
      return active() && role() == 'Sales Officer' && request.auth.uid == officerId;
    }

    function hasRole(roles) {
      return active() && role() in roles;
    }

    // Who may waive a blocking sale rule (PROJECT-OUTLINE.md §3.4). Kept in
    // step by hand with OVERRIDE_ROLES in src/services/constants.js — rules
    // cannot import JavaScript. A Sales Officer is deliberately absent: they
    // raise the order, so letting them waive their own block would make the
    // control advisory. The screen hides the button for them; THIS is what
    // makes it a control rather than a hidden button.
    function canOverrideRules() {
      return hasRole(['Super Admin', 'Managing Director', 'Area Manager']);
    }

    // Reject a write that tries to change a field it must not touch
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // The opposite restriction: this update may touch these fields and nothing
    // else. Used where a role has to move a running total but has no business
    // editing the master it sits on — a Storekeeper raising a purchase moves
    // suppliers.balance, and should not thereby be able to rewrite the
    // supplier's name or opening balance.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ── Feature 3 — no safety figure without a stated source ─────────────
    //
    // FIRESTORE-SCHEMA.md §4.1 and §9: whoClass, signalWordBn, phiDays,
    // reentryHours, firstAidBn, dosageBn and approvedCropsBn come off a
    // container label, and SafetyPanel prints `safetySource` on the dealer's
    // invoice underneath them. Figures with a blank source line are the exact
    // failure §9 was written to prevent, and this system prints them as
    // regulatory claims.
    //
    // The Product page dialog already refuses to save them, and so does
    // setSafetyData() — but neither runs for a caller who never went through
    // the screen. THIS is the control (CLAUDE.md §6), the same shape as
    // canOverrideRules() above.
    //
    // Reads request.resource.data, which on an update is the MERGED document —
    // so an unrelated update to a product that already holds figures and a
    // source still passes, because both survive the merge.

    // Six of the seven hold a scalar. A field carries a recorded value when it
    // is present and is not the empty string. NOT a truthiness test: `phiDays:
    // 0` and `reentryHours: 0` are figures a label states and a reader relies
    // on, and a falsy test would wave through the two numbers that matter most.
    //
    // No `is string` / `is list` test anywhere below, on purpose. An evaluation
    // error inside these functions would be INVISIBLE: `error || true` is true
    // in this engine, so an error would be absorbed whenever a source is
    // present and would propagate to a denial whenever one is not — that is,
    // it would behave correctly by luck and no test could catch it. Every
    // operation here is one that cannot error on any value these fields can
    // hold, verified case by case against the emulator
    // (scripts/verify-writes.mjs).
    function safetyRecorded(field) {
      let v = request.resource.data.get(field, null);
      return v != null && v != '';
    }

    // approvedCropsBn is the only list among the seven, and an empty list is an
    // absence — nothing was recorded, so it must not drag a source requirement
    // in behind it. The `!= null` guard short-circuits before .size().
    function cropsRecorded() {
      let v = request.resource.data.get('approvedCropsBn', null);
      return v != null && v.size() > 0;
    }

    function carriesSafetyFigures() {
      return safetyRecorded('whoClass')
             || safetyRecorded('signalWordBn')
             || safetyRecorded('phiDays')
             || safetyRecorded('reentryHours')
             || safetyRecorded('firstAidBn')
             || safetyRecorded('dosageBn')
             || cropsRecorded();
    }

    // A whitespace-only string is not a source, and — unlike the six above — a
    // whitespace-only FIGURE is treated as a value here rather than as an
    // absence. That is a deliberate asymmetry with isRecorded() in
    // products.js, which calls it an absence: the service can normalise it to
    // null on the way in and does, so nothing that goes through the service
    // ever reaches this rule as blank. The rules cannot rewrite a document,
    // only refuse it, and a blank string stored verbatim is data to
    // hasSafetyData() and an absence to the source check at the same time —
    // which prints a panel of blanks under a blank source line. Refusing is the
    // only move this side of the boundary has.
    function hasSafetySource() {
      let s = request.resource.data.get('safetySource', null);
      return s != null && s != '' && s.trim().size() > 0;
    }

    // All seven absent with no source is a legal write — it is how safety data
    // is CLEARED, and clearing is the honest outcome when nothing can be backed
    // (CLAUDE.md §7). safetySource is required by the figures, never on its own.
    function safetyProvenanceHolds() {
      return !carriesSafetyFigures() || hasSafetySource();
    }

    // ── Master data ──────────────────────────────────────────────────────
    // Readable by anyone signed in: the sale rules need product categories and
    // the invoice needs product names.

    match /products/{productId} {
      allow read:   if active();
      // An ADDITIONAL condition on the Super Admin write, not a replacement:
      // owning the catalogue does not include the authority to print an
      // unsourced regulatory claim on a dealer's invoice.
      allow create, update: if isSuperAdmin() && safetyProvenanceHolds();
      allow delete: if false;                       // deactivate instead
    }

    // The Managing Director writes here through isAdmin(), not isSuperAdmin().
    //
    // That is a deliberate correction, not a copy of Super Admin. The MD held
    // `permissions: 'all'` and `sales` create (through isAdmin) but was in
    // neither of these two lists, so raising a CREDIT sale failed: createSale()
    // moves customers.balance in the same batch as the invoice, and the batch
    // fails whole. A cash sale paid in full went through, a credit one did not
    // — the rules disagreed with themselves rather than with the role.
    //
    // The authority granted is an Area Manager's, without the area restriction:
    // the MD is above that role and their scope is the whole company. It stops
    // short of Super Admin, which additionally owns `products`, `licences` and
    // `users` — those are system administration, and the MD is an executive.
    match /customers/{customerId} {
      allow read:   if isAdmin()
                    || myArea(resource.data.areaId)
                    || mine(resource.data.officerId)
                    || hasRole(['Accountant']);
      allow create: if isAdmin() || hasRole(['Area Manager', 'Sales Officer']);
      allow update: if isAdmin()
                    || myArea(resource.data.areaId)
                    || mine(resource.data.officerId)
                    // the ledger owns the balance; a screen must not set it directly
                    || (hasRole(['Accountant']) && unchanged('creditLimit'));
      allow delete: if false;
    }

    // Licences are readable by anyone signed in because the point-of-sale rule
    // has to check them (Feature 1).
    match /licences/{licenceId} {
      allow read:   if active();
      allow create, update: if isSuperAdmin() || hasRole(['Area Manager', 'Accountant']);
      allow delete: if false;
    }

    // ── Sales ────────────────────────────────────────────────────────────

    match /sales/{invoiceNo} {
      allow read:   if isAdmin()
                    || myArea(resource.data.areaId)
                    || mine(resource.data.officerId)
                    || hasRole(['Accountant']);

      // An officer may only raise an order in their own name
      allow create: if isAdmin()
                    || hasRole(['Area Manager'])
                    || (hasRole(['Sales Officer']) && request.resource.data.officerId == request.auth.uid);

      // A confirmed invoice is not editable by the officer who raised it —
      // PROJECT-OUTLINE.md §3.4: they must request cancellation from the Area Manager
      allow update: if isAdmin() || myArea(resource.data.areaId);

      allow delete: if false;                       // cancel, never delete
    }

    // sale_items carry their own denormalised officerId/areaId, so they scope
    // without reading the parent sale.
    match /sale_items/{itemId} {
      allow read:   if isAdmin()
                    || myArea(resource.data.areaId)
                    || mine(resource.data.officerId)
                    || hasRole(['Accountant']);
      allow create: if isAdmin()
                    || hasRole(['Area Manager'])
                    || (hasRole(['Sales Officer']) && request.resource.data.officerId == request.auth.uid);
      allow update, delete: if false;               // a line is never edited in place
    }

    // ── Stock ────────────────────────────────────────────────────────────
    // Append-only. This is what makes the stock figure trustworthy: it can be
    // added to, never rewritten.

    match /stock_movements/{movementId} {
      allow read:   if isAdmin() || hasRole(['Storekeeper', 'Accountant', 'Area Manager', 'Sales Officer']);
      allow create: if isAdmin() || hasRole(['Storekeeper', 'Sales Officer', 'Area Manager']);
      allow update, delete: if false;
    }

    // ── Users ────────────────────────────────────────────────────────────

    // Read is the smallest grant that makes the "Received by" selector on
    // /expense work, which is the only screen that needs a staff directory.
    //
    // Security Rules cannot grant a subset of FIELDS — read is per document —
    // so "just the id and the name" is not expressible, and the real choice is
    // which ROLES may read the document at all. It goes to the Accountant, who
    // owns /expense, and to the two admin roles, whose /admin lists staff.
    // Sales Officer, Area Manager and Storekeeper keep self-only read: no
    // screen of theirs needs the directory.
    //
    // What that exposes is a colleague's name, email, role and page
    // permissions. No credential is here — Firebase Auth holds those and this
    // collection has never carried a password (that was the plaintext login
    // this replaced). Page permissions are configuration, not a secret: knowing
    // an Accountant may reach /expense tells you nothing the rules do not
    // already enforce on the server.
    //
    // WRITE stays with the Super Admin alone, including for the MD. /admin
    // edits page access, and a role that can rewrite its own permissions is a
    // Super Admin under another name — which is exactly what the MD is not.
    match /users/{uid} {
      allow read:   if isAdmin()
                    || hasRole(['Accountant'])
                    || (signedIn() && request.auth.uid == uid);
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── Audit log ────────────────────────────────────────────────────────
    // Append-only, and nobody may amend it — including a Super Admin
    // (PROJECT-OUTLINE.md §3.1). An override must carry a written reason.

    // The Area Manager reads this because they are the role that AUTHORISES an
    // override (canOverrideRules() below), and an override its own author
    // cannot audit is a weaker control than one they can. It also makes the
    // demonstration sequence continuous: §7 has the same person waive a block
    // at step 4 and read the record of it at step 5.
    //
    // The grant is company-wide, not scoped to their area, because audit_log
    // entries carry no areaId — they record a user, an action and a document,
    // and the document may belong to any collection. Scoping this would mean
    // denormalising an areaId onto every entry, which is a schema change and
    // not one worth making to narrow a log that is already append-only and
    // readable by no one who cannot already read the records it describes.
    match /audit_log/{entryId} {
      allow read:   if isAdmin() || hasRole(['Area Manager', 'Accountant']);

      // An override must carry a written reason AND come from someone entitled
      // to give one. Both halves are refused here, on the server, so the
      // control survives a caller that never went through the screen.
      allow create: if active()
                    && request.resource.data.userId == request.auth.uid
                    && (request.resource.data.action != 'rule_override'
                        || (request.resource.data.reason is string
                            && request.resource.data.reason.size() > 0
                            && canOverrideRules()));
      allow update, delete: if false;
    }

    // ── Counters ─────────────────────────────────────────────────────────
    // Document numbering. Anyone who may raise a numbered document must be able
    // to advance its sequence — otherwise the rule that lets them create the
    // document is worthless, because nextSequence() fails first and the save
    // never reaches the collection.
    //
    // The Accountant was added when the Tier 2 collections landed: /expense
    // draws on the `expenses` and `expense_vouchers` counters, so without this
    // an Accountant could be granted create on `expenses` and still not be able
    // to save one. The Storekeeper's `purchases_YYYY-MM`, `boms` and
    // `product_demands` counters are the same case.

    match /counters/{name} {
      allow read, write: if isAdmin()
                         || hasRole(['Area Manager', 'Sales Officer', 'Storekeeper', 'Accountant']);
    }

    // ══ Tier 2 ═══════════════════════════════════════════════════════════
    //
    // The fourteen collections migrated while wiring the dead Save buttons of
    // SCREEN-AUDIT.md §2.1. Each block below is derived from what its screen
    // and service actually do, not from a house pattern:
    //
    //   · WHO READS  — which roles' seeded page permissions (scripts/seed-
    //     data.mjs) reach a screen that reads the collection, including the
    //     screens that only read it to fill a selector.
    //   · WHO WRITES — which service functions write it, and what else those
    //     functions touch in the same batch. A grant here is worthless if the
    //     batch also writes a collection the same role is refused.
    //
    // None of the fourteen carries an areaId or an officerId, so none is scoped
    // per row: these are company books, not a territory's. That also means a
    // whole-collection LIST is legal for anyone granted read, which is why no
    // service function below needed the scoping treatment listCustomers() got.

    // ── Tier 2: purchasing ───────────────────────────────────────────────

    // The supplier master. A Storekeeper reads it because Purchase selects a
    // supplier, and writes it only through the payable — createPurchase() moves
    // suppliers.balance in the same batch as the invoice, so refusing the
    // update here would refuse the purchase. The rest of a supplier record
    // (name, phone, opening balance) stays with an admin, so that narrow need
    // is written as a field restriction rather than as blanket trust.
    match /suppliers/{supplierCode} {
      allow read:   if isAdmin() || hasRole(['Storekeeper']);
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (hasRole(['Storekeeper']) && onlyChanges(['balance', 'updatedAt']));
      allow delete: if false;                       // deactivate instead
    }

    // /purchase is on the Storekeeper's menu. Receiving goods writes the
    // invoice, its lines, the stock movements and the payable in one batch;
    // stock_movements already grants Storekeeper create, and the suppliers rule
    // above grants the balance move.
    match /purchases/{purchaseNo} {
      allow read:   if isAdmin() || hasRole(['Storekeeper']);
      allow create: if isAdmin() || hasRole(['Storekeeper']);
      // Cancelling and the note field. A cancelled purchase keeps its lines and
      // its reason, the same treatment cancelSale() gives an invoice.
      allow update: if isAdmin() || hasRole(['Storekeeper']);
      allow delete: if false;                       // cancel, never delete
    }

    // Written in the same batch as the purchase and never touched again —
    // sale_items' rule, for the same reason: a line is not edited in place.
    match /purchase_items/{itemId} {
      allow read:   if isAdmin() || hasRole(['Storekeeper']);
      allow create: if isAdmin() || hasRole(['Storekeeper']);
      allow update, delete: if false;
    }

    // /purchase-return is NOT on the Storekeeper's menu — sending goods back
    // and reducing what we owe is an admin decision in the seeded permissions.
    // Approving one writes stock_movements and moves the payable, both of which
    // an admin already holds.
    match /purchase_returns/{returnNo} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();                   // approve, cancel
      allow delete: if false;
    }

    // ── Tier 2: manufacturing ────────────────────────────────────────────

    // The recipe register — /batch, on the Storekeeper's menu. Read is wider
    // than the screen because /repacking builds its selector from bomOptions().
    match /boms/{bomNo} {
      allow read:   if isAdmin() || hasRole(['Storekeeper']);
      allow create, update: if isAdmin() || hasRole(['Storekeeper']);
      allow delete: if false;                       // deactivate instead
    }

    // A run consumes its materials and produces the output in one batch.
    // /repacking is admin-only on the seeded menus, so the Storekeeper who may
    // write a recipe may not execute one. That is the seeded permission set
    // read back rather than a judgement of my own; if the Storekeeper should
    // run repacking, the page permission is the thing to change first.
    match /repackings/{repackNo} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();                   // cancel
      allow delete: if false;
    }

    // ── Tier 2: inter-office stock requests ──────────────────────────────

    // /product-demand is the Storekeeper's. The screen offers Approve, Receive
    // and Cancel to whoever opens it, so update matches create: the Storekeeper
    // who raised a request can also approve it. That is a weak control, and it
    // is written plainly here rather than being quietly refused by a rule that
    // disagrees with a button the screen still shows.
    match /product_demands/{requestNo} {
      allow read:   if isAdmin() || hasRole(['Storekeeper']);
      allow create: if isAdmin() || hasRole(['Storekeeper']);
      allow update: if isAdmin() || hasRole(['Storekeeper']);
      allow delete: if false;                       // Cancel is a status
    }

    // ── Tier 2: money ────────────────────────────────────────────────────

    // The expense head master. The Accountant reads it because the Expense
    // screen's head selector is expenseHeadOptions(); it is maintained from
    // /expense-head, which only the two 'all' roles reach.
    match /expense_heads/{headId} {
      allow read:   if isAdmin() || hasRole(['Accountant']);
      allow create, update: if isAdmin();
      allow delete: if false;                       // deactivate instead
    }

    // /expense is the Accountant's, and posts both Expense and Income rows. It
    // also carries Approve and Cancel, so an Accountant can approve an expense
    // they entered — the same self-approval as product_demands, and reported
    // rather than papered over.
    match /expenses/{code} {
      allow read:   if isAdmin() || hasRole(['Accountant']);
      allow create: if isAdmin() || hasRole(['Accountant']);
      allow update: if isAdmin() || hasRole(['Accountant']);
      allow delete: if false;                       // Cancelled is a status
    }

    // The company's own bank accounts, not a dealer's. Only the two 'all' roles
    // reach either screen that touches them — /bank-account, and the "paid
    // from" selector on /supplier-payment. The Accountant is deliberately NOT
    // granted read: /cash-collection is still a sample-data screen and reads
    // nothing, so adding the role now would widen the rule ahead of the app.
    match /bank_accounts/{accountId} {
      allow read:   if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;                       // deactivate instead
    }

    // Money out to a supplier. The payable moves on APPROVAL, in the same batch
    // as the status change, so whoever may approve one also needs the suppliers
    // update above — which is why this stays with the admin roles.
    match /supplier_payments/{paymentId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();                   // edit while Pending, approve, cancel
      allow delete: if false;                       // Cancelled is a status
    }

    // One collection behind both opening-balance screens, separated by `party`.
    // Posting an entry moves the party's own balance in the same batch, so this
    // block writes customers or suppliers as well as itself. Admin-only, which
    // is also what both screens' page permissions say.
    match /opening_balances/{entryId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();                   // cancel posts the reversal
      allow delete: if false;                       // Cancel is a status
    }

    // A commission records what was awarded and deliberately moves no balance —
    // paying it is a supplier payment or a collection with its own document —
    // so unlike opening_balances nothing here reaches outside the collection.
    // Both screens are admin-only.
    match /commissions/{code} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();                   // approve, cancel
      allow delete: if false;                       // Cancelled is a status
    }

    // ── Tier 2: promotions ───────────────────────────────────────────────

    // /offers is admin-only, and nothing on the sale path reads an offer yet:
    // SalesEntry.js does not import the offers service, so a Sales Officer has
    // no query to make here. Read stays with the admin roles until the till
    // actually needs it — treating an offer as reference data the way products
    // and licences are treated would be widening the rule on a guess.
    match /offers/{code} {
      allow read:   if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;                       // Archived is the soft delete
    }

    // ── Everything else ──────────────────────────────────────────────────
    // The rest of Tier 2 (schema §10) is still sample data on screen —
    // `collections`, `sale_returns`, `damages`, `settings` and the others have
    // no service module and no rule. Denying by default means each one stays
    // closed until a rule is written for it, which is how the fourteen above
    // were caught rather than silently deploying open.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
