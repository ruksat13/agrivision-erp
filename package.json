{
  "name": "agrivision-erp",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^12.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.8.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "dev:reset": "node scripts/dev-reset.mjs",
    "start:emulator": "cross-env-shell REACT_APP_USE_EMULATOR=true react-scripts start",
    "emulators": "firebase emulators:start --only firestore,auth",
    "emulator:rules": "node scripts/emulator-rules.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:emulator": "node scripts/seed.mjs --emulator --wipe",
    "verify": "node scripts/verify.mjs",
    "verify:emulator": "node scripts/verify.mjs --emulator",
    "verify:rules": "node scripts/verify-rules.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "firebase-tools": "^15.26.0"
  }
}
